{
  "name": "tungstrike",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A free browser darts roguelite: Balatro on the oche, with a new tour every day. Working name. See `docs/brief.md`.",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "guard": "node scripts/guard.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run guard && npm run lint && npm run typecheck && npm test",
    "e2e": "playwright test",
    "gen:tables": "node scripts/gen-tables.mjs"
  },
  "dependencies": {
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
